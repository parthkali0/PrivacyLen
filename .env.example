# ---------------------------------------------------------------
# Privacy Lens — environment configuration
# Copy this file to `.env` and adjust for your machine.
# ---------------------------------------------------------------

# --- Ollama (run locally on the host, NOT inside Docker) ----------
# NOTE: Ollama is now optional. The default "fast" analysis mode uses an
# instant regex engine and never calls Ollama. Set ANALYSIS_MODE below.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_FALLBACK_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120

# --- Analysis mode -------------------------------------------------
# fast   = regex engine only (instant, <50ms, no Ollama needed)  [DEFAULT]
# hybrid = regex engine, falls back to Ollama LLM if it finds no signals
# llm    = always use the (slow) Ollama LLM path
ANALYSIS_MODE=fast

# --- Backend -------------------------------------------------------
# Comma-separated allow-list, or * for local development.
CORS_ORIGINS=*
DATABASE_URL=postgresql+psycopg://privacy:privacy@localhost:5432/privacy_lens

# --- Database (used by docker-compose) ----------------------------
POSTGRES_USER=privacy
POSTGRES_PASSWORD=privacy
POSTGRES_DB=privacy_lens

# --- Frontend ------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000