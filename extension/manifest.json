{
  "manifest_version": 3,
  "name": "Privacy Lens",
  "version": "2.0.0",
  "description": "Real-time privacy policy overlays: trust score badge, red-flag highlighting, and sign-up form detection. Turns legalese into plain English.",
  "permissions": ["tabs", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Privacy Lens"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}